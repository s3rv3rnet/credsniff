# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environment (uv recreates it from uv.lock — never commit it)
.venv/
venv/

# Build artifacts
dist/
build/
*.egg-info/

# Test / coverage / type-check caches
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.mypy_cache/
.ruff_cache/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Local scratch — never commit real secrets, even by accident
scratch/
*.local.yaml

# Private working notes: the build blueprint and the per-step learning journal.
# Anything meant for users/contributors goes in public-docs/ instead.
docs/
